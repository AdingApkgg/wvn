# 仅为配置说明，不包含密钥，也不会被应用自动加载。
# 在运行账号服务前，按部署方式将这些设置注入进程环境。
NODE_ENV=production
WG_DEPLOYMENT_MODE=preview
WG_DATABASE=state/catalog.db
WG_RESOURCE_ROOT=fixtures/resources
WG_MEDIA_ROOT=media
WG_PORT=8281
WG_ADMIN_PORT=8282
# 可选：私有转换来源清单；默认使用仓库内的空模板。
# WG_INVENTORY_FILE=state/private-inventory.json

WG_ACCOUNT_ORIGIN=https://localhost:18601
WG_ACCOUNT_PORT=18601
WG_ACCOUNT_DATABASE=state/accounts/accounts.sqlite
WG_ACCOUNT_BLOBS=state/accounts/blobs
WG_ACCOUNT_DELETION_LEDGER=state/accounts/deletions.jsonl
WG_ACCOUNT_SHARE_LEDGER=state/accounts/share-revocations.jsonl
# 自行生成随机密钥并仅保存在该文件中；不要将文件或实际密钥提交到 Git。
WG_ACCOUNT_SECRET_FILE=state/accounts/secret
WG_ACCOUNT_TLS_KEY=state/tls/private.key
WG_ACCOUNT_TLS_CERT=state/tls/certificate.crt

WG_SHARE_ADMIN_ORIGIN=https://localhost:18602
WG_SHARE_ADMIN_PORT=18602
WG_SHARE_ADMIN_TOKEN_FILE=state/accounts/share-admin-token

# 按实际资源和引擎适配情况启用 UI / 沙箱，不在示例中自动开放。
WG_ACCOUNT_UI=1
# WG_ONS_PILOT=1
# WG_ONS_CLOUD=1
# WG_ALL_ENGINES=1
