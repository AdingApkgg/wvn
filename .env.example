# 仅为配置说明，不包含密钥，也不会被应用自动加载。
# 在运行账号服务前，按部署方式将这些设置注入进程环境。
NODE_ENV=production
WG_DEPLOYMENT_MODE=preview
# 由运维预先创建 schema；连接串通过私有环境文件注入。
WG_DATABASE_URL=postgresql://wvn:CHANGE_ME@127.0.0.1:25432/wvn
WG_DATABASE_SCHEMA=catalog
WG_RESOURCE_DATABASE_SCHEMA=resources
# 资源索引如使用独立数据库，再单独设置 WG_RESOURCE_DATABASE_URL。
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:26379
MEILISEARCH_URL=http://127.0.0.1:27700
MEILI_INDEX_UID=wvn_public_works
# 查询/worker 分别注入 MEILI_SEARCH_KEY 与 MEILI_WRITE_KEY；不要发给浏览器。
WG_RESOURCE_ROOT=fixtures/resources
WG_MEDIA_ROOT=media
WG_PORT=8281
WG_ADMIN_PORT=8282
# 可选：私有转换来源清单；默认使用仓库内的空模板。
# WG_INVENTORY_FILE=state/private-inventory.json

WG_ACCOUNT_ORIGIN=https://localhost:18601
WG_ACCOUNT_PORT=18601
WG_ACCOUNT_DATABASE_URL=postgresql://wvn:CHANGE_ME@127.0.0.1:25432/wvn
WG_ACCOUNT_DATABASE_SCHEMA=accounts
WG_ACCOUNT_BLOBS=state/accounts/blobs
WG_ACCOUNT_DELETION_LEDGER=state/accounts/deletions.jsonl
WG_ACCOUNT_SHARE_LEDGER=state/accounts/share-revocations.jsonl
# 自行生成随机密钥并仅保存在该文件中；不要将文件或实际密钥提交到 Git。
WG_ACCOUNT_SECRET_FILE=state/accounts/secret
WG_ACCOUNT_TLS_KEY=state/tls/private.key
WG_ACCOUNT_TLS_CERT=state/tls/certificate.crt

WG_SHARE_ADMIN_ORIGIN=https://localhost:18602
WG_SHARE_ADMIN_PORT=18602
WG_SHARE_ADMIN_TOKEN_FILE=state/accounts/share-admin-token

# 按实际资源和引擎适配情况启用 UI / 沙箱，不在示例中自动开放。
WG_ACCOUNT_UI=1
# WG_ONS_PILOT=1
# WG_ONS_CLOUD=1
# WG_ALL_ENGINES=1

# 房间服务在账号 HTTPS listener 上挂载；SDK 不会自动申请麦克风或摄像头。
WG_ROOMS_ENABLED=0
# WG_TURN_URLS=turn:turn.example.invalid:3478?transport=udp,turns:turn.example.invalid:5349?transport=tcp
# WG_TURN_SECRET=由私有环境文件提供，与 coturn static-auth-secret 相同
# WG_WEBTRANSPORT_URL=https://rooms-wt.example.invalid:28443/rooms
# WT/QUIC、TURN 使用独立可达入口，不能配置为普通 CF 橙云回源。
