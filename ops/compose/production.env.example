# 这是生产覆盖项示例，不包含秘密，不能替代 prepare 生成的完整私有环境。
# 生产切换需单独授权，先恢复并验收既有数据、密钥和存档，再配置入口代理。
WVN_COMPOSE_PROJECT=wvn-production
WVN_DEPLOYMENT_MODE=production
WVN_IMAGE=wvn-app:reviewed-release
WVN_STATE_ROOT=/srv/wvn/production-state
WVN_WEB_ORIGIN=https://wvn.example.invalid
WVN_WEB_HOST=wvn.example.invalid
WVN_WEB_PORT=18891
WVN_WEB_TLS_SERVERNAME=localhost
WVN_RESOURCE_UPSTREAM=http://100.64.0.20:18896
WVN_RESOURCE_ROOT=/srv/wvn/games
WVN_MEDIA_ROOT=/srv/wvn/covers
WVN_PLAYER_MEDIA_ROOT=/srv/wvn/player-media
# 若沿用既有远程存档，启用 compose.storage-client.yaml，并使用原存储令牌文件。
WVN_BLOB_UPSTREAM=http://100.64.0.20:18897
WVN_BLOB_TOKEN_FILE=/srv/wvn/private/blob-token
