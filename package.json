{
  "name": "wg-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "react-router build",
    "start": "tsx server.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "seed": "tsx scripts/seed.ts",
    "start:accounts": "tsx accounts-server.ts",
    "accounts:backup": "tsx scripts/account-backup.ts",
    "accounts:restore": "tsx scripts/account-backup.ts restore"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@react-router/node": "8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "isbot": "5.1.40",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.3.6",
    "better-auth": "1.7.6",
    "@better-auth/passkey": "1.7.6",
    "@simplewebauthn/server": "13.3.3",
    "@simplewebauthn/browser": "13.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@react-router/dev": "8.4.0",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "overrides": {
    "@better-auth/core": "1.7.6",
    "@better-auth/utils": "0.4.2",
    "better-call": "1.4.0"
  }
}
