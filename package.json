{
  "name": "wg-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "react-router build",
    "start": "tsx server.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test tests/e2e/poster-layout.spec.ts tests/e2e/reader-experience.spec.ts tests/e2e/m3-design.spec.ts tests/e2e/sidebar-navigation.spec.ts tests/e2e/cover-feedback.spec.ts tests/e2e/version-classification.spec.ts tests/e2e/version-defaults.spec.ts",
    "seed": "tsx scripts/seed.ts",
    "start:accounts": "tsx accounts-server.ts",
    "accounts:backup": "tsx scripts/account-backup.ts",
    "accounts:restore": "tsx scripts/account-backup.ts restore",
    "db:init": "tsx scripts/initialize-platform.ts",
    "start:resources": "tsx src/resources/server.ts",
    "search:worker": "tsx scripts/search-index.ts worker 100",
    "search:rebuild": "tsx scripts/search-index.ts rebuild",
    "api:openapi": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.14",
    "@hono/node-server": "1.19.17",
    "@react-router/node": "8.4.0",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "better-auth": "1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "isbot": "5.1.40",
    "lucide-react": "^1.59.0",
    "meilisearch": "0.62.0",
    "motion": "14.14.0",
    "pg": "8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "redis": "6.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.21.0",
    "tw-animate-css": "^1.4.0",
    "ws": "8.22.0",
    "zod": "4.6.7",
    "@orpc/client": "1.16.2",
    "@orpc/contract": "1.16.2",
    "@orpc/openapi": "1.16.2",
    "@orpc/server": "1.16.2",
    "@orpc/openapi-client": "1.16.2",
    "@orpc/zod": "1.16.2",
    "@scalar/api-reference": "1.78.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@react-router/dev": "8.4.0",
    "@types/node": "24.10.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "overrides": {
    "@better-auth/core": "1.7.14"
  }
}
